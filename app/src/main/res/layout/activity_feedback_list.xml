<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"

    >

<LinearLayout
android:id="@+id/layout_feedback_list"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="20dp"
android:background="#FFF8F0"
    >

<TextView
    android:id="@+id/tvTitleFeedback"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Danh sách phản hồi"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="#D35400"
android:layout_marginBottom="16dp"
android:fontFamily="sans-serif-medium"/>

<!-- Nút Thêm Phản Hồi -->
<Button
    android:id="@+id/btnMyFeedback"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Phản hồi của bạn"
    android:textColor="#9B1D1D"
    android:textAllCaps="false"
    android:backgroundTint="#E67E22"
android:paddingLeft="24dp"
android:paddingRight="24dp"
android:paddingTop="12dp"
android:paddingBottom="12dp"
android:layout_marginBottom="16dp"
android:fontFamily="sans-serif-medium"
android:elevation="4dp"
android:background="@drawable/btn_rounded_orange"/>

<!-- Danh sách phản hồi của người khác -->
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvFeedbackList"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingBottom="8dp"
    android:scrollbars="vertical"/>

<!-- Progress bar loading -->
<ProgressBar
    android:id="@+id/progressBar"
    style="?android:attr/progressBarStyleLarge"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="center"
    android:visibility="gone"
    android:layout_marginTop="20dp"
    android:indeterminateTint="#E67E22" />

</LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
