<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF8F0">

    <TextView
        android:text="Phản hồi của bạn"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#D35400"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>

    <EditText
        android:id="@+id/etFeedbackContent"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="top"
        android:hint="Nhập nội dung phản hồi..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@drawable/et_rounded_background"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textColorHint="#CC7A00" />

    <Button
        android:id="@+id/btnSaveFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu"
        android:textAllCaps="false"
        android:textColor="#9B1D1D"
        android:backgroundTint="#E67E22"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        android:background="@drawable/btn_rounded_orange"/>

    <Button
        android:id="@+id/btnDeleteFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xoá phản hồi"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D3002E"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        />

</LinearLayout>
